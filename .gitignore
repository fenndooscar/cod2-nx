# Nothing derived from the game is ever committed: its files, the code generated from default.xex, and the
# binaries built from that code.

# --- Game files ---------------------------------------------------------------
assets/
*.xex
*.xexp
*.iso
*.bin
*.big
*.bun
*.viv
*.nfsp

# --- Generated from the game --------------------------------------------------
generated/
app*/generated/
app*/src/copias_literales/
app*/src/cod2_nativo_resplandor_*_spirv.h
app_*/

# Reports about the game's own code. They are lists of addresses in default.xex, so
# they are derived from it, and tools/huecos.py rewrites them on every run.
docs/huecos.txt
docs/punteros.txt
tools/huecos_functions.toml

# --- Build output -------------------------------------------------------------
out/
build/
*.nro
*.nacp
*.elf
*.o
*.obj
*.exe
*.a
*.log
*.err
shaders/wasm/out/

# --- Third-party sources ------------------------------------------------------
# Only the files this port changes are committed (see THIRD_PARTY_NOTICES.md). The rest comes from the ReXGlue
# release through tools/fetch_thirdparty.py, which is step 1 of docs/building.md. Without these rules that step
# leaves about 19,000 vendored files in `git status`.
sdk/thirdparty/*
!sdk/thirdparty/CMakeLists.txt
!sdk/thirdparty/FFmpeg/
sdk/thirdparty/FFmpeg/*
!sdk/thirdparty/FFmpeg/config.h
!sdk/thirdparty/FFmpeg/config_cod2_wmv3.h
!sdk/thirdparty/FFmpeg/config_switch_aarch64.h
!sdk/thirdparty/FFmpeg/libavcodec/
sdk/thirdparty/FFmpeg/libavcodec/*
!sdk/thirdparty/FFmpeg/libavcodec/fft_template.c
!sdk/thirdparty/FFmpeg/libavcodec/mdct_template.c
!sdk/thirdparty/ffmpeg-overlay/
sdk/thirdparty/ffmpeg-overlay/*
!sdk/thirdparty/ffmpeg-overlay/codec_list.c

# --- Tools --------------------------------------------------------------------
__pycache__/
*.pyc
.vs/
.vscode/
graphify-out/
mesa/mesa-switch
# Ghidra's project database. The Ghidra GUI creates it in the repository root when the project is
# opened from here; nothing in it belongs to the port.
cod2-nx.rep/
cod2-nx.gpr
cod2-nx.lock
cod2-nx.lock~

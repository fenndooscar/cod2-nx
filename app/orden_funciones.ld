/*
 * Hot functions grouped at the start of .text, hottest first, taken from stack sampling on the console.
 *
 * Regenerate with (DEVKITPRO set, so that addr2line and nm are found):
 *   python tools/calientes.py <rex_perfil.log> <cod2.elf> <out.txt> app/orden_funciones.ld
 * The log and the ELF have to belong to the same build, and the log has to come from a session that reaches a
 * level: menus and cutscenes rank the wrong functions. See the tool's own header for the weights and their skew.
 *
 * Each function is listed under both of its names, sub_X and __imp__sub_X: which of the two owns the section is
 * not fixed, and the linker ignores an entry whose section it cannot find without saying so. Check the result
 * with `python tools/comprobar_orden.py`, which reads cod2.map.
 */
.text : {
  /*
   * libnx's startup code (crt0) must stay at address 0, as in switch.ld. An earlier version
   * of this file moved it (memcpy ended up at 0) and the NRO did not boot.
   */
  KEEP (*(.crt0))
  /* Assembly functions without their own section: named by file (libc and FFmpeg NEON). */
  *libc.a:libc_a-memcpy.o(.text .text.*)
  *libc.a:libc_a-memmove.o(.text .text.*)
  *libc.a:libc_a-memset.o(.text .text.*)
  *libc.a:libc_a-memcmp.o(.text .text.*)
  *libc.a:libc_a-strcmp.o(.text .text.*)
  *liblibavcodec.a:fft_neon.S.obj(.text .text.*)
  *liblibavcodec.a:mdct_neon.S.obj(.text .text.*)
  *liblibavutil.a:float_dsp_neon.S.obj(.text .text.*)
